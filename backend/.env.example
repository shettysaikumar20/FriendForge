# Backend only. Supply private values locally or in the Render dashboard.
BACKBOARD_API_KEY=
APP_PASSWORD=
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional: fixed assistant identity. Otherwise persisted in DATA_DIR.
BACKBOARD_ASSISTANT_ID=
# Leave empty locally to use backend/data. Set to the disk mount in Render.
DATA_DIR=
# Local AI configuration (optional, non-secret)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# ElevenLabs Text-to-Speech configuration (backend only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
